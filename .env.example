ANTHROPIC_API_KEY=sk-ant-api03-...   # Obtener en https://console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6    # claude-opus-5 para mejor vision
ANTHROPIC_COACH_MODEL=claude-opus-4-8  # coach (/coach) y resumen semanal

# El puerto debe coincidir con el mapeo de docker-compose.yml (5433 -> 5432)
DATABASE_URL=postgresql://fitmoi:fitmoi@localhost:5433/fitmoi

FLASK_ENV=development
FLASK_DEBUG=0                        # 1 expone el depurador de Werkzeug en la red local

# Candado de acceso. Vacio = sin candado (dev local). En produccion pon un
# secreto largo y aleatorio: sin el, la API queda abierta a cualquiera (incluido
# el gasto de la API de Anthropic). Generar: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=
COOKIE_SECURE=0                      # 1 en produccion (HTTPS): la cookie solo viaja cifrada

# Confiar en las cabeceras X-Forwarded-* del proxy (Railway) para reconstruir el
# esquema/host reales. Necesario en produccion tras un proxy que termina el TLS,
# o el redirect_uri de OAuth sale como http:// y no cuadra con el https://
# registrado. Ponlo a 0 solo si expones el servicio SIN proxy delante.
TRUST_PROXY=1

# Determina que cuenta como "hoy" en la vista diaria
APP_TIMEZONE=Europe/Madrid

# Whoop OAuth. Vacio = integracion desactivada. Obtener Client ID/Secret en el
# portal de developer de Whoop (https://developer.whoop.com). La redirect URL a
# registrar alli es https://TU-DOMINIO/api/whoop/callback (y en dev
# http://localhost:5000/api/whoop/callback). Deja WHOOP_REDIRECT_URI vacio para
# derivarla de la peticion, o fijala si el dominio no coincide.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_SCOPES=                        # vacio = offline read:profile read:workout read:cycles read:recovery

# Withings OAuth (bascula inteligente). Vacio = integracion desactivada. Obtener
# Client ID/Secret en el portal de developer de Withings
# (https://developer.withings.com). La redirect URL a registrar alli es
# https://TU-DOMINIO/api/withings/callback (y en dev
# http://localhost:5000/api/withings/callback). Deja WITHINGS_REDIRECT_URI vacio
# para derivarla de la peticion, o fijala si el dominio no coincide. De Withings
# se traen las mediciones de la bascula (peso + composicion corporal) al
# historico de peso.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=
WITHINGS_SCOPES=                     # vacio = user.metrics

# Sync automatico a las 00:00 (zona de APP_TIMEZONE). Whoop: gasto energetico y
# workouts. Withings: pesadas de la bascula. SCHEDULER_ENABLED=0 lo desactiva.
# *_SYNC_DAYS es la ventana que repasa cada noche (por si algun dato llego tarde).
SCHEDULER_ENABLED=1
WHOOP_SYNC_DAYS=7
WITHINGS_SYNC_DAYS=30
# Ventana amplia que se trae SOLO al conectar la bascula por primera vez, para
# rellenar de golpe el historico de peso y composicion (progreso en el tiempo).
WITHINGS_INITIAL_SYNC_DAYS=365

# Relativo (dev) se ancla a backend/. En Railway pon aqui la ruta ABSOLUTA de un
# volumen persistente, p. ej. /data/uploads, o las fotos se borran en cada deploy.
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
IMAGE_MAX_DIMENSION=1568
IMAGE_JPEG_QUALITY=85
ORPHAN_MAX_AGE_HOURS=24
